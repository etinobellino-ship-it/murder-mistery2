SheriffLabel.TextColor3 = Theme.SheriffColor
SheriffLabel.BackgroundTransparency = 1
SheriffLabel.TextScaled = true

CreateToggle("Insta-Kill Murderer (Click)", false, CombatTab, function(v) Settings.SheriffInstaKill = v end)

local MurderLabel = Instance.new("TextLabel", CombatTab)
MurderLabel.Text = "--- MURDERER SECTION ---"
MurderLabel.Size = UDim2.new(1, 0, 0, 20)
MurderLabel.TextColor3 = Theme.MurderColor
MurderLabel.BackgroundTransparency = 1
MurderLabel.Position = UDim2.new(0, 0, 0, 50)
MurderLabel.TextScaled = true

CreateToggle("Kill Aura", false, CombatTab, function(v) Settings.KillAura = v end)
CreateToggle("Knife Throw Aura (Auto)", false, CombatTab, function(v) Settings.KnifeThrowAura = v end)
CreateSlider("Aura Range", 10, 100, 20, CombatTab, function(v) Settings.AuraRange = v end)

-- // LOGIC ENGINE
local function GetPlayerRole(player)
    if not player or not player.Character then return "Innocent" end
    local roleAttr = player:GetAttribute("Role")
    if roleAttr then return roleAttr end
    for _, item in pairs(player.Character:GetChildren()) do
        if item:IsA("Tool") then
            if item.Name:lower():find("knife") then return "Murderer" end
            if item.Name:lower():find("gun") or item.Name:lower():find("revolver") then return "Sheriff" end
        end
    end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, item in pairs(bp:GetChildren()) do
            if item:IsA("Tool") then
                if item.Name:lower():find("knife") then return "Murderer" end
                if item.Name:lower():find("gun") or item.Name:lower():find("revolver") then return "Sheriff" end
            end
        end
    end
    return "Innocent"
end

local function IsVisible(target)
    local origin = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.new()
    local targetPos = target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character.HumanoidRootPart.Position or Vector3.new()
    local direction = (targetPos - origin).Unit * (targetPos - origin).Magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    local result = workspace:Raycast(origin, direction, raycastParams)
    return result == nil or result.Instance:IsDescendantOf(target.Character)
end

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 and Settings.SheriffInstaKill then
        local mouseTarget = LocalPlayer:GetMouse().Target
        if mouseTarget and mouseTarget.Parent:FindFirstChild("Humanoid") then
            local targetPlayer = Players:GetPlayerFromCharacter(mouseTarget.Parent)
            if targetPlayer and GetPlayerRole(targetPlayer) == "Murderer" and IsVisible(targetPlayer) then
                for _, v in pairs(RepStorage:GetDescendants()) do
                    if v:IsA("RemoteEvent") and v.Name:lower():find("shoot") then v:FireServer(targetPlayer) end
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = Settings.WalkSpeed
    end

    if Settings.KillAura or Settings.KnifeThrowAura then
        local char = LocalPlayer.Character
        if char and (char:FindFirstChild("Knife") or GetPlayerRole(LocalPlayer) == "Murderer") then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (char.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if dist <= Settings.AuraRange and IsVisible(p) then
                        if Settings.KillAura then 
                            for _, v in pairs(RepStorage:GetDescendants()) do
                                if v:IsA("RemoteEvent") and v.Name:lower():find("attack") then v:FireServer(p) end
                            end
                        elseif Settings.KnifeThrowAura then 
                            for _, v in pairs(RepStorage:GetDescendants()) do
                                if v:IsA("RemoteEvent") and v.Name:lower():find("throw") then v:FireServer(p) end
                            end
                        end
                    end
                end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if Settings.EspEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hl = p.Character:FindFirstChild("XenoESP") or Instance.new("Highlight", p.Character)
                hl.Name = "XenoESP"
                hl.Enabled = true
                hl.FillTransparency = 0.4
                hl.OutlineTransparency = 0
                local role = GetPlayerRole(p)
                if role == "Murderer" then 
                    hl.FillColor = Theme.MurderColor -- ROSSO
                elseif role == "Sheriff" then 
                    hl.FillColor = Theme.SheriffColor -- BLU
                else 
                    hl.FillColor = Theme.InnocentColor -- BIANCO (Innocenti)
                end
                hl.OutlineColor = Color3.new(1, 1, 1)
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hl = p.Character:FindFirstChild("XenoESP")
                if hl then hl.Enabled = false end
            end
        end
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
    -- Salva lo stato attuale per riaprirlo
    Settings.Save = Settings
end)

-- Dragging System
local dragging, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- Funzione per riaprire la GUI
local function ReopenGUI()
    local newScreenGui = Instance.new("ScreenGui")
    newScreenGui.Name = "NegroFiducia_Combat"
    newScreenGui.ResetOnSpawn = false
    newScreenGui.Parent = game:GetService("CoreGui")

    local newMainFrame = Instance.new("Frame")
    newMainFrame.Parent = newScreenGui
    newMainFrame.BackgroundColor3 = Theme.Main
    newMainFrame.Position = Settings.Save.Position or UDim2.new(0.5, -275, 0.5, -190)
    newMainFrame.Size = UDim2.new(0, 550, 0, 380)
    newMainFrame.ClipsDescendants = true

    -- Attiva le impostazioni salvate
    for key, value in pairs(Settings.Save) do
        Settings[key] = value
    end

    -- ... (Continua con il resto della configurazione della GUI)
end

-- Connetti la funzione di riapertura a un evento o pulsante
-- Ad esempio, puoi aggiungere un pulsante nel menu principale del gioco per riaprire la GUI
```
