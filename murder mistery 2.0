local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local VirtualUser = game:GetService("VirtualUser")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

--// SETTINGS
local Settings = {
    Murder = { KillAura = false, KillAuraRange = 12, AutoKillVisible = false, AutoKillRange = 50 },
    Sheriff = { InstantKill = false, AutoShoot = false, ShootRange = 200 },
    Fling = { Enabled = false, Target = nil, Power = 500, AntiFling = false, SpecificTarget = nil },
    ESP = { Enabled = false, Boxes = true, Names = true, Distance = true, Roles = true, Tracers = false, MaxDistance = 1500 },
    Movement = { Speed = 16, Jump = 50, Fly = false, FlySpeed = 60, NoClip = false, InfiniteJump = false, AutoSprint = false },
    Farming = { AutoFarm = false, SmartFarm = true, CoinMagnet = false, MagnetRange = 60, AutoGrabGun = false, FarmSpeed = 250 },
    Misc = { FullBright = false, AntiAfk = true, NoFog = false }
}

--// CACHE
local ESPObjects = {}
local LastUpdate = 0
local Flinging = {}
local LastStab = 0
local LastShoot = 0

--// UTILITY
local function GetCharacter(player) return player and player.Character end
local function GetRootPart(char) return char and char:FindFirstChild("HumanoidRootPart") end
local function GetHumanoid(char) return char and char:FindFirstChildOfClass("Humanoid") end

local function GetPlayerRole(player)
    if not player then return "Innocent", Color3.fromRGB(150, 255, 150) end
    local backpack = player:FindFirstChild("Backpack")
    local char = GetCharacter(player)
    if (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
        return "Murderer", Color3.fromRGB(255, 50, 50)
    elseif (backpack and backpack:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun")) then
        return "Sheriff", Color3.fromRGB(50, 100, 255)
    end
    return "Innocent", Color3.fromRGB(150, 255, 150)
end

local function GetMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        local role = GetPlayerRole(p)
        if role == "Murderer" then return p end
    end
    return nil
end

local function GetSheriff()
    for _, p in pairs(Players:GetPlayers()) do
        local role = GetPlayerRole(p)
        if role == "Sheriff" then return p end
    end
    return nil
end

--// UI LIBRARY (identico al tuo)
local UI = {}
function UI:CreateWindow(title)
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MM2HubV7"
    ScreenGui.Parent = CoreGui
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.ResetOnSpawn = false
    
    local DragonButton = Instance.new("TextButton")
    DragonButton.Size = UDim2.new(0, 70, 0, 70)
    DragonButton.Position = UDim2.new(1, -90, 0, 25)
    DragonButton.BackgroundColor3 = Color3.fromRGB(100, 180, 255)
    DragonButton.Text = "🐉"
    DragonButton.TextSize = 40
    DragonButton.Font = Enum.Font.GothamBold
    DragonButton.Parent = ScreenGui
    
    Instance.new("UICorner", DragonButton).CornerRadius = UDim.new(1, 0)
    
    local Main = Instance.new("Frame")
    Main.Size = UDim2.new(0, 750, 0, 500)
    Main.Position = UDim2.new(0.5, -375, 0.5, -250)
    Main.BackgroundColor3 = Color3.fromRGB(20, 25, 35)
    Main.BorderSizePixel = 0
    Main.Visible = false
    Main.Parent = ScreenGui
    
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 20)
    
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(100, 180, 255)
    Stroke.Thickness = 2
    Stroke.Parent = Main
    
    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 50)
    TopBar.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
    TopBar.BorderSizePixel = 0
    TopBar.Parent = Main
    
    Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 20)
    
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(0.7, 0, 1, 0)
    Title.Position = UDim2.new(0, 20, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = title
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 22
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = TopBar
    
    local Close = Instance.new("TextButton")
    Close.Size = UDim2.new(0, 35, 0, 35)
    Close.Position = UDim2.new(1, -45, 0, 7)
    Close.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    Close.Text = "×"
    Close.TextColor3 = Color3.fromRGB(255, 255, 255)
    Close.TextSize = 24
    Close.Font = Enum.Font.GothamBold
    Close.Parent = TopBar
    
    Instance.new("UICorner", Close).CornerRadius = UDim.new(0, 10)
    
    local TabFrame = Instance.new("Frame")
    TabFrame.Size = UDim2.new(0, 180, 1, -50)
    TabFrame.Position = UDim2.new(0, 0, 0, 50)
    TabFrame.BackgroundColor3 = Color3.fromRGB(25, 30, 40)
    TabFrame.BorderSizePixel = 0
    TabFrame.Parent = Main
    
    local ContentFrame = Instance.new("Frame")
    ContentFrame.Size = UDim2.new(1, -180, 1, -50)
    ContentFrame.Position = UDim2.new(0, 180, 0, 50)
    ContentFrame.BackgroundTransparency = 1
    ContentFrame.Parent = Main
    
    local Window = {ScreenGui = ScreenGui, Main = Main, DragonButton = DragonButton, TabFrame = TabFrame, ContentFrame = ContentFrame, Tabs = {}, CurrentTab = nil}
    
    local function ToggleGUI(show)
        if show then
            Main.Visible = true
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Size = UDim2.new(0, 750, 0, 500)}):Play()
            DragonButton.Visible = false
        else
            TweenService:Create(Main, TweenInfo.new(0.3), {Size = UDim2.new(0, 750, 0, 0)}):Play()
            task.delay(0.3, function() Main.Visible = false DragonButton.Visible = true end)
        end
    end
    
    Close.MouseButton1Click:Connect(function() ToggleGUI(false) end)
    DragonButton.MouseButton1Click:Connect(function() ToggleGUI(true) end)
    
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Insert then ToggleGUI(not Main.Visible) end
    end)
    
    local dragging, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    
    return Window
end

function UI:CreateTab(window, name, icon, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 45)
    btn.Position = UDim2.new(0.05, 0, 0, #window.Tabs * 50 + 10)
    btn.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
    btn.Text = ""
    btn.Parent = window.TabFrame
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
    
    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.new(0, 35, 0, 35)
    iconLabel.Position = UDim2.new(0, 10, 0.5, -17)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = icon
    iconLabel.TextSize = 24
    iconLabel.Parent = btn
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -50, 1, 0)
    textLabel.Position = UDim2.new(0, 45, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = name
    textLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    textLabel.TextSize = 15
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Parent = btn
    
    local content = Instance.new("ScrollingFrame")
    content.Size = UDim2.new(1, 0, 1, 0)
    content.BackgroundTransparency = 1
    content.ScrollBarThickness = 4
    content.ScrollBarImageColor3 = color
    content.Visible = false
    content.Parent = window.ContentFrame
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 15)
    layout.Parent = content
    
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 20)
    padding.PaddingRight = UDim.new(0, 20)
    padding.PaddingTop = UDim.new(0, 20)
    padding.PaddingBottom = UDim.new(0, 20)
    padding.Parent = content
    
    local tab = {Button = btn, Content = content, TextLabel = textLabel, Color = color}
    table.insert(window.Tabs, tab)
    
    btn.MouseButton1Click:Connect(function()
        if window.CurrentTab == tab then return end
        for _, t in pairs(window.Tabs) do
            t.Content.Visible = false
            t.Button.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
            t.TextLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        window.CurrentTab = tab
        content.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(50, 55, 70)
        textLabel.TextColor3 = color
    end)
    
    return content
end

function UI:CreateSection(parent, title, accentColor)
    local section = Instance.new("Frame")
    section.Size = UDim2.new(1, 0, 0, 0)
    section.AutomaticSize = Enum.AutomaticSize.Y
    section.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
    section.BorderSizePixel = 0
    section.Parent = parent
    
    Instance.new("UICorner", section).CornerRadius = UDim.new(0, 15)
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = accentColor
    stroke.Thickness = 1
    stroke.Transparency = 0.5
    stroke.Parent = section
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 30)
    label.Position = UDim2.new(0, 15, 0, 10)
    label.BackgroundTransparency = 1
    label.Text = title
    label.TextColor3 = accentColor
    label.TextSize = 18
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = section
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 0)
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.Position = UDim2.new(0, 0, 0, 45)
    container.BackgroundTransparency = 1
    container.Parent = section
    
    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 12)
    list.Parent = container
    
    local containerPadding = Instance.new("UIPadding")
    containerPadding.PaddingLeft = UDim.new(0, 15)
    containerPadding.PaddingRight = UDim.new(0, 15)
    containerPadding.PaddingBottom = UDim.new(0, 15)
    containerPadding.Parent = container
    
    return container
end

function UI:CreateToggle(parent, text, default, callback, accent)
    accent = accent or Color3.fromRGB(100, 180, 255)
    local toggle = Instance.new("Frame")
    toggle.Size = UDim2.new(1, 0, 0, 45)
    toggle.BackgroundTransparency = 1
    toggle.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 15
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = toggle
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 55, 0, 28)
    btn.Position = UDim2.new(1, -55, 0.5, -14)
    btn.BackgroundColor3 = default and accent or Color3.fromRGB(50, 50, 60)
    btn.Text = ""
    btn.Parent = toggle
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 24, 0, 24)
    circle.Position = default and UDim2.new(1, -26, 0.5, -12) or UDim2.new(0, 2, 0.5, -12)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.Parent = btn
    
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)
    
    local enabled = default
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = enabled and accent or Color3.fromRGB(50, 50, 60)}):Play()
        TweenService:Create(circle, TweenInfo.new(0.2), {Position = enabled and UDim2.new(1, -26, 0.5, -12) or UDim2.new(0, 2, 0.5, -12)}):Play()
        if callback then callback(enabled) end
    end)
    return toggle
end

function UI:CreateSlider(parent, text, min, max, default, callback, accent)
    accent = accent or Color3.fromRGB(100, 180, 255)
    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(1, 0, 0, 60)
    slider.BackgroundTransparency = 1
    slider.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 0, 25)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 15
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = slider
    
    local value = Instance.new("TextLabel")
    value.Size = UDim2.new(0.4, 0, 0, 25)
    value.Position = UDim2.new(0.6, 0, 0, 0)
    value.BackgroundTransparency = 1
    value.Text = tostring(default)
    value.TextColor3 = accent
    value.TextSize = 15
    value.Font = Enum.Font.GothamBold
    value.TextXAlignment = Enum.TextXAlignment.Right
    value.Parent = slider
    
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 45)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    track.BorderSizePixel = 0
    track.Parent = slider
    
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local knob = Instance.new("TextButton")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = UDim2.new((default - min) / (max - min), -10, 0.5, -10)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Text = ""
    knob.Parent = track
    
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    
    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pos)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, -10, 0.5, -10)
        value.Text = tostring(val)
        if callback then callback(val) end
    end
    
    knob.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    track.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then update(input) end end)
end

function UI:CreateButton(parent, text, callback, accent)
    accent = accent or Color3.fromRGB(100, 180, 255)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 45)
    btn.BackgroundColor3 = accent
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 15
    btn.Font = Enum.Font.GothamBold
    btn.Parent = parent
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
    
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(130, 210, 255)}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = accent}):Play() end)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

function UI:CreatePlayerButton(parent, player, callback, accent)
    accent = accent or Color3.fromRGB(100, 180, 255)
    local role, color = GetPlayerRole(player)
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
    btn.Text = player.Name .. " [" .. role .. "]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.Gotham
    btn.Parent = parent
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    local roleIndicator = Instance.new("Frame")
    roleIndicator.Size = UDim2.new(0, 6, 1, 0)
    roleIndicator.BackgroundColor3 = color
    roleIndicator.Parent = btn
    
    Instance.new("UICorner", roleIndicator).CornerRadius = UDim.new(0, 8)
    
    btn.MouseButton1Click:Connect(function()
        Settings.Fling.SpecificTarget = player
        if callback then callback(player) end
    end)
    
    return btn
end

--// CREATE UI
local Window = UI:CreateWindow("❄️ MM2 ELITE HUB v7.2")

local MurderColor = Color3.fromRGB(255, 50, 50)
local SheriffColor = Color3.fromRGB(50, 100, 255)
local FlingColor = Color3.fromRGB(255, 100, 200)
local ESPColor = Color3.fromRGB(100, 255, 150)
local MoveColor = Color3.fromRGB(100, 150, 255)
local FarmColor = Color3.fromRGB(255, 200, 100)
local MiscColor = Color3.fromRGB(200, 100, 255)

local CombatTab = UI:CreateTab(Window, "Combat", "⚔️", MurderColor)
local FlingTab = UI:CreateTab(Window, "Fling", "🚀", FlingColor)
local ESP_Tab = UI:CreateTab(Window, "ESP", "👁️", ESPColor)
local MoveTab = UI:CreateTab(Window, "Movement", "🏃", MoveColor)
local FarmTab = UI:CreateTab(Window, "Farming", "💰", FarmColor)
local MiscTab = UI:CreateTab(Window, "Misc", "⚙️", MiscColor)

--// === MURDERER SECTION ===
local murderSec = UI:CreateSection(CombatTab, "🔴 MURDERER", MurderColor)
UI:CreateToggle(murderSec, "Kill Aura", false, function(v) Settings.Murder.KillAura = v end, MurderColor)
UI:CreateSlider(murderSec, "Kill Aura Range", 5, 50, 12, function(v) Settings.Murder.KillAuraRange = v end, MurderColor)
UI:CreateToggle(murderSec, "Auto Kill Visible", false, function(v) Settings.Murder.AutoKillVisible = v end, MurderColor)
UI:CreateSlider(murderSec, "Auto Kill Range", 10, 100, 50, function(v) Settings.Murder.AutoKillRange = v end, MurderColor)

--// === SHERIFF SECTION ===
local sheriffSec = UI:CreateSection(CombatTab, "🔵 SHERIFF", SheriffColor)
UI:CreateToggle(sheriffSec, "Instant Kill Murderer", false, function(v) Settings.Sheriff.InstantKill = v end, SheriffColor)
UI:CreateToggle(sheriffSec, "Auto Shoot Murderer", false, function(v) Settings.Sheriff.AutoShoot = v end, SheriffColor)
UI:CreateSlider(sheriffSec, "Shoot Range", 50, 500, 200, function(v) Settings.Sheriff.ShootRange = v end, SheriffColor)

--// === FLING SECTION ===
local flingSec = UI:CreateSection(FlingTab, "🚀 FLING CONTROLS", FlingColor)

-- Quick Fling Buttons (ora funzionanti)
UI:CreateButton(flingSec, "Fling Murderer", function()
    local murderer = GetMurderer()
    if murderer then
        FlingPlayer(murderer)
    end
end, Color3.fromRGB(255, 50, 50))

UI:CreateButton(flingSec, "Fling Sheriff", function()
    local sheriff = GetSheriff()
    if sheriff then
        FlingPlayer(sheriff)
    end
end, Color3.fromRGB(50, 100, 255))

UI:CreateSlider(flingSec, "Fling Power", 100, 5000, 1000, function(v) Settings.Fling.Power = v end, FlingColor)
UI:CreateToggle(flingSec, "Anti Fling (God Mode)", false, function(v) Settings.Fling.AntiFling = v end, FlingColor)

-- Player List
local playerListSec = UI:CreateSection(FlingTab, "👥 SELECT PLAYER TO FLING", FlingColor)
local playerListFrame = Instance.new("ScrollingFrame")
playerListFrame.Size = UDim2.new(1, 0, 0, 200)
playerListFrame.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
playerListFrame.BorderSizePixel = 0
playerListFrame.ScrollBarThickness = 4
playerListFrame.Parent = playerListSec

Instance.new("UICorner", playerListFrame).CornerRadius = UDim.new(0, 10)

local plLayout = Instance.new("UIListLayout")
plLayout.Padding = UDim.new(0, 5)
plLayout.Parent = playerListFrame

Instance.new("UIPadding", playerListFrame).PaddingLeft = UDim.new(0, 10)
playerListFrame:FindFirstChildOfClass("UIPadding").PaddingRight = UDim.new(0, 10)
playerListFrame:FindFirstChildOfClass("UIPadding").PaddingTop = UDim.new(0, 10)

local function UpdatePlayerList()
    for _, child in pairs(playerListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            UI:CreatePlayerButton(playerListFrame, player, function(p)
                FlingPlayer(p)
            end, FlingColor)
        end
    end
    
    playerListFrame.CanvasSize = UDim2.new(0, 0, 0, plLayout.AbsoluteContentSize.Y + 20)
end

UI:CreateButton(flingSec, "🔄 Refresh Player List", UpdatePlayerList, FlingColor)

