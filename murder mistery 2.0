UI:CreateButton(miscSec, "Server Hop", function()
    local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    for _, server in pairs(servers.data) do
        if server.playing < server.maxPlayers and server.id ~= game.JobId then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id)
            break
        end
    end
end, MiscColor)

UI:CreateButton(miscSec, "Rejoin Server", function()
    TeleportService:Teleport(game.PlaceId)
end, MiscColor)

--// === ESP SYSTEM ===
local function CreateESP(player)
    if player == LocalPlayer then return end
    ESPObjects[player] = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        Role = Drawing.new("Text"),
        Tracer = Drawing.new("Line")
    }
    for _, obj in pairs(ESPObjects[player]) do
        obj.Visible = false
        obj.Center = true
    end
    ESPObjects[player].Box.Thickness = 1
    ESPObjects[player].Box.Filled = false
    ESPObjects[player].Tracer.Thickness = 1
end

RunService.RenderStepped:Connect(function()
    if tick() - LastUpdate < 0.03 then return end
    LastUpdate = tick()
    
    for player, esp in pairs(ESPObjects) do
        local success = pcall(function()
            if not Settings.ESP.Enabled then
                for _, obj in pairs(esp) do obj.Visible = false end
                return
            end
            
            local char = GetCharacter(player)
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") then
                local pos, onScreen = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
                local myChar = GetCharacter(LocalPlayer)
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                
                if myRoot and onScreen then
                    local dist = (myRoot.Position - char.HumanoidRootPart.Position).Magnitude
                    if dist <= Settings.ESP.MaxDistance then
                        local role, color = GetPlayerRole(player)
                        local scale = math.clamp(1000 / pos.Z, 10, 50)
                        
                        if Settings.ESP.Boxes then
                            esp.Box.Size = Vector2.new(scale * 0.6, scale * 1.2)
                            esp.Box.Position = Vector2.new(pos.X - scale * 0.3, pos.Y - scale * 0.6)
                            esp.Box.Color = color
                            esp.Box.Visible = true
                        else esp.Box.Visible = false end
                        
                        if Settings.ESP.Names then
                            esp.Name.Position = Vector2.new(pos.X, pos.Y - scale * 0.8)
                            esp.Name.Text = player.Name
                            esp.Name.Color = color
                            esp.Name.Size = 13
                            esp.Name.Visible = true
                        else esp.Name.Visible = false end
                        
                        if Settings.ESP.Distance then
                            esp.Distance.Position = Vector2.new(pos.X, pos.Y + scale * 0.7)
                            esp.Distance.Text = math.floor(dist) .. "m"
                            esp.Distance.Color = Color3.fromRGB(255, 255, 255)
                            esp.Distance.Size = 11
                            esp.Distance.Visible = true
                        else esp.Distance.Visible = false end
                        
                        if Settings.ESP.Roles then
                            esp.Role.Position = Vector2.new(pos.X, pos.Y - scale * 1.1)
                            esp.Role.Text = role
                            esp.Role.Color = color
                            esp.Role.Size = 12
                            esp.Role.Visible = true
                        else esp.Role.Visible = false end
                        
                        if Settings.ESP.Tracers then
                            esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            esp.Tracer.To = Vector2.new(pos.X, pos.Y)
                            esp.Tracer.Color = color
                            esp.Tracer.Visible = true
                        else esp.Tracer.Visible = false end
                    else
                        for _, obj in pairs(esp) do obj.Visible = false end
                    end
                else
                    for _, obj in pairs(esp) do obj.Visible = false end
                end
            else
                for _, obj in pairs(esp) do obj.Visible = false end
            end
        end)
        if not success then for _, obj in pairs(esp) do obj.Visible = false end end
    end
end)

--// === MURDERER SYSTEM (KILL AURA FIXATA) ===
task.spawn(function()
    while task.wait(0.1) do
        local char = GetCharacter(LocalPlayer)
        if not char then continue end
        
        local knife = LocalPlayer.Backpack:FindFirstChild("Knife") or char:FindFirstChild("Knife")
        if not knife then continue end
        
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if not remotes then continue end
        
        -- Equip knife se in backpack
        if LocalPlayer.Backpack:FindFirstChild("Knife") and char:FindFirstChild("Humanoid") then
            char.Humanoid:EquipTool(LocalPlayer.Backpack.Knife)
        end
        
        -- Kill Aura con cooldown
        if Settings.Murder.KillAura and tick() - LastStab > 0.3 then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local targetChar = GetCharacter(p)
                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("Humanoid") then
                        if targetChar.Humanoid.Health > 0 then
                            local dist = (targetChar.HumanoidRootPart.Position - char:GetPivot().Position).Magnitude
                            if dist <= Settings.Murder.KillAuraRange then
                                local stab = remotes:FindFirstChild("Stab")
                                if stab then 
                                    stab:FireServer()
                                    LastStab = tick()
                                end
                            end
                        end
                    end
                end
            end
        end
        
        -- Auto Kill Visible (Throw) con cooldown
        if Settings.Murder.AutoKillVisible and tick() - LastStab > 0.5 then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local targetChar = GetCharacter(p)
                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("Humanoid") then
                        if targetChar.Humanoid.Health > 0 then
                            local dist = (targetChar.HumanoidRootPart.Position - char:GetPivot().Position).Magnitude
                            if dist <= Settings.Murder.AutoKillRange then
                                local head = targetChar:FindFirstChild("Head")
                                if head then
                                    -- Raycast per visibilità
                                    local raycastParams = RaycastParams.new()
                                    raycastParams.FilterDescendantsInstances = {char, targetChar}
                                    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                                    
                                    local direction = (head.Position - Camera.CFrame.Position).Unit * 500
                                    local result = Workspace:Raycast(Camera.CFrame.Position, direction, raycastParams)
                                    
                                    if not result or result.Instance:IsDescendantOf(targetChar) then
                                        local throw = remotes:FindFirstChild("ThrowKnife")
                                        if throw then
                                            throw:FireServer("Throw", head.Position + Vector3.new(0, 0.5, 0))
                                            LastStab = tick()
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

--// === SHERIFF SYSTEM (AUTO SHOOT FIXATO) ===
task.spawn(function()
    while task.wait(0.05) do
        local char = GetCharacter(LocalPlayer)
        if not char then continue end
        
        local gun = LocalPlayer.Backpack:FindFirstChild("Gun") or char:FindFirstChild("Gun")
        if not gun then continue end
        
        -- Equip gun se in backpack
        if LocalPlayer.Backpack:FindFirstChild("Gun") and char:FindFirstChild("Humanoid") then
            char.Humanoid:EquipTool(LocalPlayer.Backpack.Gun)
        end
        
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if not remotes then continue end
        
        local murderer = GetMurderer()
        if not murderer then continue end
        
        local murdererChar = GetCharacter(murderer)
        if not murdererChar then continue end
        
        local murdererHead = murdererChar:FindFirstChild("Head")
        local murdererRoot = murdererChar:FindFirstChild("HumanoidRootPart")
        local murdererHumanoid = murdererChar:FindFirstChild("Humanoid")
        if not murdererHead or not murdererRoot or not murdererHumanoid then continue end
        if murdererHumanoid.Health <= 0 then continue end
        
        local myRoot = GetRootPart(char)
        if not myRoot then continue end
        
        local dist = (murdererRoot.Position - myRoot.Position).Magnitude
        
        -- Controlla visibilità
        local canShoot = false
        if dist <= Settings.Sheriff.ShootRange then
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {char, murdererChar}
            raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
            
            local direction = (murdererHead.Position - Camera.CFrame.Position).Unit * dist
            local result = Workspace:Raycast(Camera.CFrame.Position, direction, raycastParams)
            
            if not result or result.Instance:IsDescendantOf(murdererChar) then
                canShoot = true
            end
        end
        
        -- Instant Kill (con cooldown 0.3s)
        if Settings.Sheriff.InstantKill and canShoot and tick() - LastShoot > 0.3 then
            local shoot = remotes:FindFirstChild("ShootGun")
            if shoot then
                local targetPos = murdererHead.Position + (murdererHead.Velocity * 0.1)
                shoot:FireServer(targetPos, murdererHead)
                LastShoot = tick()
            end
        end
        
        -- Auto Shoot (con cooldown 0.5s)
        if Settings.Sheriff.AutoShoot and canShoot and tick() - LastShoot > 0.5 then
            local shoot = remotes:FindFirstChild("ShootGun")
            if shoot then
                local targetPos = murdererHead.Position + (murdererHead.Velocity * 0.05)
                shoot:FireServer(targetPos, murdererHead)
                LastShoot = tick()
            end
        end
    end
end)

--// === FLING SYSTEM (FIXATA) ===
local function FlingPlayer(target)
    if not target then return end
    local targetChar = GetCharacter(target)
    if not targetChar then return end
    local targetRoot = GetRootPart(targetChar)
    if not targetRoot then return end
    
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(myChar)
    if not myRoot then return end
    
    -- Calcola direzione (lontano da te)
    local direction = (targetRoot.Position - myRoot.Position).Unit
    local flingForce = direction * Settings.Fling.Power + Vector3.new(0, Settings.Fling.Power * 0.6, 0)
    
    -- Applica fling continuamente per 0.6 secondi
    task.spawn(function()
        local startTime = tick()
        while tick() - startTime < 0.6 do
            if targetRoot and targetRoot.Parent then
                targetRoot.AssemblyLinearVelocity = flingForce
                targetRoot.AssemblyAngularVelocity = Vector3.new(
                    math.random(-50, 50),
                    math.random(-50, 50), 
                    math.random(-50, 50)
                )
            else
                break
            end
            task.wait(0.03)
        end
    end)
end

-- Fling Loop (per modalità continua)
task.spawn(function()
    while task.wait(0.1) do
        if Settings.Fling.Enabled and Settings.Fling.SpecificTarget then
            FlingPlayer(Settings.Fling.SpecificTarget)
            task.wait(0.2)
        end
    end
end)

-- Anti Fling
RunService.Stepped:Connect(function()
    if Settings.Fling.AntiFling then
        local myChar = GetCharacter(LocalPlayer)
        if not myChar then return end
        
        for _, part in pairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                for _, child in pairs(part:GetChildren()) do
                    if child:IsA("BodyVelocity") or child:IsA("BodyGyro") or child:IsA("BodyPosition") then
                        if child.Name ~= "FlyVel" and child.Name ~= "FlyGyro" then
                            child:Destroy()
                        end
                    end
                end
                part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)

--// === MOVEMENT SYSTEMS ===
-- Fly
RunService.RenderStepped:Connect(function()
    local char = GetCharacter(LocalPlayer)
    if not char then return end
    local root = GetRootPart(char)
    if not root then return end
    
    if Settings.Movement.Fly then
        if not root:FindFirstChild("FlyGyro") then
            local gyro = Instance.new("BodyGyro")
            gyro.Name = "FlyGyro"
            gyro.MaxTorque = Vector3.new(500000, 500000, 500000)
            gyro.Parent = root
            
            local vel = Instance.new("BodyVelocity")
            vel.Name = "FlyVel"
            vel.MaxForce = Vector3.new(500000, 500000, 500000)
            vel.Parent = root
        end
        
        local gyro = root.FlyGyro
        local vel = root.FlyVel
        local dir = Vector3.new(0, 0, 0)
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
        
        gyro.CFrame = Camera.CFrame
        vel.Velocity = dir * Settings.Movement.FlySpeed
    else
        if root:FindFirstChild("FlyGyro") then root.FlyGyro:Destroy() end
        if root:FindFirstChild("FlyVel") then root.FlyVel:Destroy() end
    end
end)

-- No Clip
RunService.Stepped:Connect(function()
    if Settings.Movement.NoClip then
        local char = GetCharacter(LocalPlayer)
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end
end)

