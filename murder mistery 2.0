local Window = UI:CreateWindow("❄️ MM2 ELITE HUB v7.1")

local MurderColor = Color3.fromRGB(255, 50, 50)
local SheriffColor = Color3.fromRGB(50, 100, 255)
local FlingColor = Color3.fromRGB(255, 100, 200)
local ESPColor = Color3.fromRGB(100, 255, 150)
local MoveColor = Color3.fromRGB(
