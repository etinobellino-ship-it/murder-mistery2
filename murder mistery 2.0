    MM2 PREMIUM HUB v4.0
    Inspired by Solix & Snowy Hub
    Clean, Fast, Working
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local VirtualUser = game:GetService("VirtualUser")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

--// UI LIBRARY (Custom)
local Library = {}

function Library:CreateWindow(title)
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MM2Hub"
    ScreenGui.Parent = game.CoreGui
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.ResetOnSpawn = false
    
    -- Main Frame
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = UDim2.new(0, 550, 0, 350)
    Main.Position = UDim2.new(0.5, -275, 0.5, -175)
    Main.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    Main.BorderSizePixel = 0
    Main.Parent = ScreenGui
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Main
    
    -- Shadow
    local Shadow = Instance.new("ImageLabel")
    Shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    Shadow.BackgroundTransparency = 1
    Shadow.Position = UDim2.new(0.5, 0, 0.5, 6)
    Shadow.Size = UDim2.new(1, 20, 1, 20)
    Shadow.ZIndex = -1
    Shadow.Image = "rbxassetid://5554236805"
    Shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    Shadow.ImageTransparency = 0.5
    Shadow.ScaleType = Enum.ScaleType.Slice
    Shadow.SliceCenter = Rect.new(23, 23, 277, 277)
    Shadow.Parent = Main
    
    -- Top Bar
    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 35)
    TopBar.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    TopBar.BorderSizePixel = 0
    TopBar.Parent = Main
    
    local TopCorner = Instance.new("UICorner")
    TopCorner.CornerRadius = UDim.new(0, 8)
    TopCorner.Parent = TopBar
    
    local TopFix = Instance.new("Frame")
    TopFix.Size = UDim2.new(1, 0, 0.5, 0)
    TopFix.Position = UDim2.new(0, 0, 0.5, 0)
    TopFix.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    TopFix.BorderSizePixel = 0
    TopFix.Parent = TopBar
    
    -- Title
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(0.5, 0, 1, 0)
    Title.Position = UDim2.new(0, 15, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = title
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 16
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = TopBar
    
    -- Version
    local Version = Instance.new("TextLabel")
    Version.Size = UDim2.new(0, 50, 1, 0)
    Version.Position = UDim2.new(0, 150, 0, 0)
    Version.BackgroundTransparency = 1
    Version.Text = "v4.0"
    Version.TextColor3 = Color3.fromRGB(100, 150, 255)
    Version.TextSize = 12
    Version.Font = Enum.Font.Gotham
    Version.TextXAlignment = Enum.TextXAlignment.Left
    Version.Parent = TopBar
    
    -- Close Button
    local Close = Instance.new("TextButton")
    Close.Size = UDim2.new(0, 25, 0, 25)
    Close.Position = UDim2.new(1, -35, 0, 5)
    Close.BackgroundColor3 = Color3.fromRGB(255, 75, 75)
    Close.Text = "×"
    Close.TextColor3 = Color3.fromRGB(255, 255, 255)
    Close.TextSize = 18
    Close.Font = Enum.Font.GothamBold
    Close.Parent = TopBar
    
    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(0, 6)
    CloseCorner.Parent = Close
    
    -- Minimize Button
    local Minimize = Instance.new("TextButton")
    Minimize.Size = UDim2.new(0, 25, 0, 25)
    Minimize.Position = UDim2.new(1, -65, 0, 5)
    Minimize.BackgroundColor3 = Color3.fromRGB(255, 185, 0)
    Minimize.Text = "−"
    Minimize.TextColor3 = Color3.fromRGB(255, 255, 255)
    Minimize.TextSize = 18
    Minimize.Font = Enum.Font.GothamBold
    Minimize.Parent = TopBar
    
    local MinCorner = Instance.new("UICorner")
    MinCorner.CornerRadius = UDim.new(0, 6)
    MinCorner.Parent = Minimize
    
    -- Tab Buttons Container
    local TabButtons = Instance.new("Frame")
    TabButtons.Size = UDim2.new(0, 130, 1, -35)
    TabButtons.Position = UDim2.new(0, 0, 0, 35)
    TabButtons.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    TabButtons.BorderSizePixel = 0
    TabButtons.Parent = Main
    
    -- Tab Content Container
    local TabContent = Instance.new("Frame")
    TabContent.Size = UDim2.new(1, -130, 1, -35)
    TabContent.Position = UDim2.new(0, 130, 0, 35)
    TabContent.BackgroundTransparency = 1
    TabContent.Parent = Main
    
    local Tabs = {}
    local CurrentTab = nil
    
    local Window = {
        ScreenGui = ScreenGui,
        Main = Main,
        TabButtons = TabButtons,
        TabContent = TabContent,
        Tabs = Tabs,
        CurrentTab = nil
    }
    
    -- Dragging
    local dragging = false
    local dragStart, startPos
    
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    -- Close/Minimize
    local minimized = false
    Minimize.MouseButton1Click:Connect(function()
        minimized = not minimized
        TabContent.Visible = not minimized
        TabButtons.Visible = not minimized
        Minimize.Text = minimized and "+" or "−"
    end)
    
    Close.MouseButton1Click:Connect(function()
        ScreenGui.Enabled = false
    end)
    
    -- Toggle with Insert
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Insert then
            ScreenGui.Enabled = not ScreenGui.Enabled
        end
    end)
    
    return Window
end

function Library:CreateTab(window, name, icon)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, #window.Tabs * 40 + 10)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    btn.Text = ""
    btn.Parent = window.TabButtons
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.new(0, 25, 0, 25)
    iconLabel.Position = UDim2.new(0, 8, 0.5, -12)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = icon or "•"
    iconLabel.TextSize = 18
    iconLabel.Parent = btn
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -35, 1, 0)
    textLabel.Position = UDim2.new(0, 35, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = name
    textLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    textLabel.TextSize = 13
    textLabel.Font = Enum.Font.GothamSemibold
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Parent = btn
    
    local content = Instance.new("ScrollingFrame")
    content.Size = UDim2.new(1, 0, 1, 0)
    content.BackgroundTransparency = 1
    content.ScrollBarThickness = 3
    content.ScrollBarImageColor3 = Color3.fromRGB(100, 150, 255)
    content.Visible = false
    content.Parent = window.TabContent
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 10)
    layout.Parent = content
    
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 15)
    padding.PaddingRight = UDim.new(0, 15)
    padding.PaddingTop = UDim.new(0, 15)
    padding.PaddingBottom = UDim.new(0, 15)
    padding.Parent = content
    
    local tab = {
        Button = btn,
        Content = content,
        TextLabel = textLabel
    }
    
    table.insert(window.Tabs, tab)
    
    btn.MouseButton1Click:Connect(function()
        if window.CurrentTab == tab then return end
        
        -- Hide all
        for _, t in pairs(window.Tabs) do
            t.Content.Visible = false
            t.Button.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            t.TextLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        
        -- Show selected
        window.CurrentTab = tab
        content.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        textLabel.TextColor3 = Color3.fromRGB(100, 150, 255)
    end)
    
    return content
end

function Library:CreateSection(parent, title)
    local section = Instance.new("Frame")
    section.Size = UDim2.new(1, 0, 0, 0)
    section.AutomaticSize = Enum.AutomaticSize.Y
    section.BackgroundTransparency = 1
    section.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.BackgroundTransparency = 1
    label.Text = title
    label.TextColor3 = Color3.fromRGB(100, 150, 255)
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = section
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 0)
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.Position = UDim2.new(0, 0, 0, 25)
    container.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    container.BorderSizePixel = 0
    container.Parent = section
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = container
    
    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 8)
    list.Parent = container
    
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 12)
    pad.PaddingRight = UDim.new(0, 12)
    pad.PaddingTop = UDim.new(0, 12)
    pad.PaddingBottom = UDim.new(0, 12)
    pad.Parent = container
    
    return container
end

function Library:CreateToggle(parent, text, default, callback)
    local toggle = Instance.new("Frame")
    toggle.Size = UDim2.new(1, 0, 0, 35)
    toggle.BackgroundTransparency = 1
    toggle.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = toggle
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 45, 0, 22)
    btn.Position = UDim2.new(1, -45, 0.5, -11)
    btn.BackgroundColor3 = default and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 65)
    btn.Text = ""
    btn.Parent = toggle
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn
    
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 18, 0, 18)
    circle.Position = default and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.Parent = btn
    
    local cc = Instance.new("UICorner")
    cc.CornerRadius = UDim.new(1, 0)
    cc.Parent = circle
    
    local enabled = default
    
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = enabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 65)
        }):Play()
        TweenService:Create(circle, TweenInfo.new(0.2), {
            Position = enabled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        }):Play()
        if callback then callback(enabled) end
    end)
    
    return toggle
end

function Library:CreateSlider(parent, text, min, max, default, callback)
    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(1, 0, 0, 50)
    slider.BackgroundTransparency = 1
    slider.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 0, 20)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = slider
    
    local value = Instance.new("TextLabel")
    value.Size = UDim2.new(0.4, 0, 0, 20)
    value.Position = UDim2.new(0.6, 0, 0, 0)
    value.BackgroundTransparency = 1
    value.Text = tostring(default)
    value.TextColor3 = Color3.fromRGB(100, 150, 255)
    value.TextSize = 13
    value.Font = Enum.Font.GothamBold
    value.TextXAlignment = Enum.TextXAlignment.Right
    value.Parent = slider
    
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 4)
    track.Position = UDim2.new(0, 0, 0, 35)
    track.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    track.BorderSizePixel = 0
    track.Parent = slider
    
    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(1, 0)
    tc.Parent = track
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    fill.BorderSizePixel = 0
    fill.Parent = track
    
    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill
    
    local knob = Instance.new("TextButton")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new((default - min) / (max - min), -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Text = ""
    knob.Parent = track
    
    local kc = Instance.new("UICorner")
    kc.CornerRadius = UDim.new(1, 0)
    kc.Parent = knob
    
    local dragging = false
    
    local function update(input)
        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pos)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, -7, 0.5, -7)
        value.Text = tostring(val)
        if callback then callback(val) end
    end
    
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            update(input)
        end
    end)
end

function Library:CreateButton(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.Parent = parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(120, 170, 255)}):Play()
    end)
    
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(100, 150, 255)}):Play()
    end)
    
    btn.MouseButton1Click:Connect(callback)
    
    return btn
end

--// CREATE UI
local Window = Library:CreateWindow("MM2 PREMIUM HUB")

--// TABS
local CombatTab = Library:CreateTab(Window, "Combat", "⚔️")
local VisualsTab = Library:CreateTab(Window, "Visuals", "👁️")
local MovementTab = Library:CreateTab(Window, "Movement", "🏃")
local FarmingTab = Library:CreateTab(Window, "Farming", "💰")
local PlayersTab = Library:CreateTab(Window, "Players", "👥")
local MiscTab = Library:CreateTab(Window, "Misc", "⚙️")

--// SETTINGS
local Settings = {
    Combat = { Aimbot = false, KillAura = false, AutoStab = false, AutoShoot = false, FOV = 100, Smoothness = 0.1 },
    ESP = { Enabled = false, Boxes = true, Names = true, Distance = true, Roles = true, MaxDistance = 1000 },
    Movement = { Speed = 16, Jump = 50, Fly = false, FlySpeed = 50, NoClip = false, InfiniteJump = false },
    Farming = { AutoFarm = false, CoinMagnet = false, MagnetRange = 50, AutoGrabGun = false },
    Misc = { FullBright = false, AntiAfk = false }
}

--// COMBAT
local cSection = Library:CreateSection(CombatTab, "Combat Features")
Library:CreateToggle(cSection, "Aimbot", false, function(v) Settings.Combat.Aimbot = v end)
Library:CreateToggle(cSection, "Kill Aura", false, function(v) Settings.Combat.KillAura = v end)
Library:CreateToggle(cSection, "Auto Stab (Murderer)", false, function(v) Settings.Combat.AutoStab = v end)
Library:CreateToggle(cSection, "Auto Shoot (Sheriff)", false, function(v) Settings.Combat.AutoShoot = v end)
Library:CreateSlider(cSection, "Aimbot FOV", 10, 500, 100, function(v) Settings.Combat.FOV = v end)
Library:CreateSlider(cSection, "Smoothness", 1, 100, 10, function(v) Settings.Combat.Smoothness = v/100 end)

--// VISUALS
local vSection = Library:CreateSection(VisualsTab, "ESP Settings")
Library:CreateToggle(vSection, "Player ESP", false, function(v) Settings.ESP.Enabled = v end)
Library:CreateToggle(vSection, "Show Boxes", true, function(v) Settings.ESP.Boxes = v end)
Library:CreateToggle(vSection, "Show Names", true, function(v) Settings.ESP.Names = v end)
Library:CreateToggle(vSection, "Show Distance", true, function(v) Settings.ESP.Distance = v end)
Library:CreateToggle(vSection, "Show Roles", true, function(v) Settings.ESP.Roles = v end)
Library:CreateSlider(vSection, "Max Distance", 100, 2000, 1000, function(v) Settings.ESP.MaxDistance = v end)

--// MOVEMENT
local mSection = Library:CreateSection(MovementTab, "Movement")
Library:CreateToggle(mSection, "Fly", false, function(v) Settings.Movement.Fly = v end)
Library:CreateToggle(mSection, "No Clip", false, function(v) Settings.Movement.NoClip = v end)
Library:CreateToggle(mSection, "Infinite Jump", false, function(v) Settings.Movement.InfiniteJump = v end)
Library:CreateSlider(mSection, "WalkSpeed", 16, 200, 16, function(v) 
    Settings.Movement.Speed = v
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = v
    end
end)
Library:CreateSlider(mSection, "JumpPower", 50, 200, 50, function(v) 
    Settings.Movement.Jump = v
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character.Humanoid.JumpPower = v
    end
end)
Library:CreateSlider(mSection, "Fly Speed", 10, 200, 50, function(v) Settings.Movement.FlySpeed = v end)

--// FARMING
local fSection = Library:CreateSection(FarmingTab, "Auto Farm")
Library:CreateToggle(fSection, "Auto Farm Coins", false, function(v) Settings.Farming.AutoFarm = v end)
Library:CreateToggle(fSection, "Coin Magnet", false, function(v) Settings.Farming.CoinMagnet = v end)
Library:CreateToggle(fSection, "Auto Grab Gun", false, function(v) Settings.Farming.AutoGrabGun = v end)
Library:CreateSlider(fSection, "Magnet Range", 10, 100, 50, function(v) Settings.Farming.MagnetRange = v end)

--// PLAYERS
local pSection = Library:CreateSection(PlayersTab, "Player List")

local playerList = Instance.new("ScrollingFrame")
playerList.Size = UDim2.new(1, 0, 0, 120)
playerList.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
playerList.BorderSizePixel = 0
playerList.ScrollBarThickness = 3
playerList.Parent = pSection

local plCorner = Instance.new("UICorner")
plCorner.CornerRadius = UDim.new(0, 6)
plCorner.Parent = playerList

local plLayout = Instance.new("UIListLayout")
plLayout.Padding = UDim.new(0, 5)
plLayout.Parent = playerList

local plPad = Instance.new("UIPadding")
plPad.PaddingLeft = UDim.new(0, 10)
plPad.PaddingRight = UDim.new(0, 10)
plPad.PaddingTop = UDim.new(0, 10)
plPad.Parent = playerList

local function UpdatePlayerList()
    for _, child in pairs(playerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 30)
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
            btn.Text = player.Name
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.TextSize = 12
            btn.Font = Enum.Font.Gotham
            btn.Parent = playerList
            
            local bc = Instance.new("UICorner")
            bc.CornerRadius = UDim.new(0, 4)
            bc.Parent = btn
            
            btn.MouseButton1Click:Connect(function()
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame
                end
            end)
        end
    end
    
    playerList.CanvasSize = UDim2.new(0, 0, 0, plLayout.AbsoluteContentSize.Y + 20)
end

Library:CreateButton(pSection, "Refresh List", UpdatePlayerList)
Library:CreateButton(pSection, "Teleport to Random", function()
    local players = Players:GetPlayers()
    local random = players[math.random(1, #players)]
    if random and random ~= LocalPlayer and random.Character then
        LocalPlayer.Character.HumanoidRootPart.CFrame = random.Character.HumanoidRootPart.CFrame
    end
end)

--// MISC
local sSection = Library:CreateSection(MiscTab, "Settings")
Library:CreateToggle(sSection, "Full Bright", false, function(v) 
    Settings.Misc.FullBright = v
    Lighting.Brightness = v and 10 or 1
    Lighting.GlobalShadows = not v
end)
Library:CreateToggle(sSection, "Anti AFK", false, function(v) Settings.Misc.AntiAfk = v end)
Library:CreateButton(sSection, "Server Hop", function()
    local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    for _, server in pairs(servers.data) do
        if server.playing < server.maxPlayers then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id)
            break
        end
    end
end)
Library:CreateButton(sSection, "Rejoin", function()
    TeleportService:Teleport(game.PlaceId)
end)

--// FEATURES IMPLEMENTATION

-- ESP
local ESPObjects = {}
local function CreateESP(player)
    if player == LocalPlayer then return end
    ESPObjects[player] = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        Role = Drawing.new("Text")
    }
    for _, obj in pairs(ESPObjects[player]) do
        obj.Visible = false
        obj.Center = true
    end
    ESPObjects[player].Box.Thickness = 1
    ESPObjects[player].Box.Filled = false
end

RunService.RenderStepped:Connect(function()
    for player, esp in pairs(ESPObjects) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            local dist = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
            
            if onScreen and dist <= Settings.ESP.MaxDistance and Settings.ESP.Enabled then
                local role, color = "Innocent", Color3.fromRGB(0, 255, 0)
                if player.Backpack:FindFirstChild("Knife") or player.Character:FindFirstChild("Knife") then
                    role, color = "Murderer", Color3.fromRGB(255, 0, 0)
                elseif player.Backpack:FindFirstChild("Gun") or player.Character:FindFirstChild("Gun") then
                    role, color = "Sheriff", Color3.fromRGB(0, 100, 255)
                end
                
                local scale = math.clamp(1000 / pos.Z, 10, 50)
                
                if Settings.ESP.Boxes then
                    esp.Box.Size = Vector2.new(scale * 0.6, scale * 1.2)
                    esp.Box.Position = Vector2.new(pos.X - scale * 0.3, pos.Y - scale * 0.6)
                    esp.Box.Color = color
                    esp.Box.Visible = true
                else esp.Box.Visible = false end
                
                if Settings.ESP.Names then
                    esp.Name.Position = Vector2.new(pos.X, pos.Y - scale * 0.8)
                    esp.Name.Text = player.Name
                    esp.Name.Color = color
                    esp.Name.Size = 13
                    esp.Name.Visible = true
                else esp.Name.Visible = false end
                
                if Settings.ESP.Distance then
                    esp.Distance.Position = Vector2.new(pos.X, pos.Y + scale * 0.7)
                    esp.Distance.Text = math.floor(dist) .. "m"
                    esp.Distance.Color = Color3.fromRGB(255, 255, 255)
                    esp.Distance.Size = 11
                    esp.Distance.Visible = true
                else esp.Distance.Visible = false end
                
                if Settings.ESP.Roles then
                    esp.Role.Position = Vector2.new(pos.X, pos.Y - scale * 1.1)
                    esp.Role.Text = role
                    esp.Role.Color = color
                    esp.Role.Size = 12
                    esp.Role.Visible = true
                else esp.Role.Visible = false end
            else
                for _, obj in pairs(esp) do obj.Visible = false end
            end
        else
            for _, obj in pairs(esp) do obj.Visible = false end
        end
    end
end)

-- Aimbot
local function GetClosest()
    local closest, minDist = nil, Settings.Combat.FOV
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
            local pos = Camera:WorldToViewportPoint(p.Character.Head.Position)
            local d = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
            if d < minDist then minDist, closest = d, p end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if Settings.Combat.Aimbot then
        local target = GetClosest()
        if target and target.Character then
            local pos = target.Character.Head.Position
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), Settings.Combat.Smoothness)
        end
    end
end)

-- Fly
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if Settings.Movement.Fly then
        if not root:FindFirstChild("FlyGyro") then
            local g = Instance.new("BodyGyro", root)
            g.Name = "FlyGyro"
            g.MaxTorque = Vector3.new(500000, 500000, 500000)
            local v = Instance.new("BodyVelocity", root)
            v.Name = "FlyVel"
            v.MaxForce = Vector3.new(500000, 500000, 500000)
        end
        local gyro = root.FlyGyro
        local vel = root.FlyVel
        local dir = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
        gyro.CFrame = Camera.CFrame
        vel.Velocity = dir * Settings.Movement.FlySpeed
    else
        if root:FindFirstChild("FlyGyro") then root.FlyGyro:Destroy() end
        if root:FindFirstChild("FlyVel") then root.FlyVel:Destroy() end
    end
end)

-- No Clip
RunService.Stepped:Connect(function()
    if Settings.Movement.NoClip and LocalPlayer.Character then
        for _, p in pairs(LocalPlayer.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

-- Infinite Jump
UserInputService.JumpRequest:Connect(function()
    if Settings.Movement.InfiniteJump and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- Auto Farm
spawn(function()
    while wait(0.1) do
        local char = LocalPlayer.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        
        if Settings.Farming.AutoFarm then
            for _, coin in pairs(Workspace:GetDescendants()) do
                if coin.Name == "Coin" and coin:IsA("BasePart") then
                    root.CFrame = coin.CFrame
                    wait(0.2)
                end
            end
        end
        
        if Settings.Farming.CoinMagnet then
            for _, coin in pairs(Workspace:GetDescendants()) do
                if coin.Name == "Coin" and coin:IsA("BasePart") then
                    if (coin.Position - root.Position).Magnitude <= Settings.Farming.MagnetRange then
                        coin.CFrame = root.CFrame
                    end
                end
            end
        end
        
        if Settings.Farming.AutoGrabGun then
            for _, item in pairs(Workspace:GetDescendants()) do
                if item.Name == "GunDrop" or item.Name == "DroppedGun" then
                    local part = item:IsA("Model") and item:FindFirstChildWhichIsA("BasePart") or item
                    if part then
                        root.CFrame = CFrame.new(part.Position)
                        wait(0.5)
                    end
                end
            end
        end
    end
end)

-- Combat
spawn(function()
    while wait(0.1) do
        local char = LocalPlayer.Character
        if not char then continue end
        
        local knife = LocalPlayer.Backpack:FindFirstChild("Knife") or char:FindFirstChild("Knife")
        local gun = LocalPlayer.Backpack:FindFirstChild("Gun") or char:FindFirstChild("Gun")
        
        if knife and Settings.Combat.KillAura then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if (p.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude <= 10 then
                        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ThrowKnife"):FireServer("Throw", p.Character.HumanoidRootPart.Position)
                    end
                end
            end
        end
        
        if knife and Settings.Combat.AutoStab then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if (p.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude <= 6 then
                        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Stab"):FireServer()
                    end
                end
            end
        end
        
        if gun and Settings.Combat.AutoShoot then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    if p.Backpack:FindFirstChild("Knife") or p.Character:FindFirstChild("Knife") then
                        if p.Character:FindFirstChild("Head") then
                            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ShootGun"):FireServer(p.Character.Head.Position, p.Character.Head)
                        end
                    end
                end
            end
        end
    end
end)

-- Anti AFK
LocalPlayer.Idled:Connect(function()
    if Settings.Misc.AntiAfk then
        VirtualUser:Button2Down(Vector2.new(0,0), Camera.CFrame)
        wait(1)
        VirtualUser:Button2Up(Vector2.new(0,0), Camera.CFrame)
    end
end)

-- Init
for _, p in pairs(Players:GetPlayers()) do CreateESP(p) end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(function(p)
    if ESPObjects[p] then
        for _, o in pairs(ESPObjects[p]) do o:Remove() end
        ESPObjects[p] = nil
    end
    UpdatePlayerList()
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    wait(0.5)
    if Settings.Movement.Speed ~= 16 then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = Settings.Movement.Speed end
    end
    if Settings.Movement.Jump ~= 50 then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.JumpPower = Settings.Movement.Jump end
    end
end)

