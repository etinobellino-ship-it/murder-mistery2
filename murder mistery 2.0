-- Coin Magnet
CreateToggle(MainPage, "Coin Magnet", function(enabled)
    CoinMagnetEnabled = enabled
    spawn(function()
        while CoinMagnetEnabled do
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                for _, coin in pairs(Workspace:GetDescendants()) do
                    if coin.Name == "Coin" and coin:IsA("BasePart") then
                        local distance = (coin.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                        if distance < 50 then
                            coin.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
                        end
                    end
                end
            end
            wait(0.1)
        end
    end)
end, 410)

-- Auto Farm
