end)

--// === FARMING SYSTEM ===
task.spawn(function()
    while task.wait(0.2) do
        if not Settings.Farming.AutoFarm then continue end
        
        local root = GetRootPart(GetCharacter(LocalPlayer))
        if not root then continue end
        
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():match("coin") then
                local dist = (obj.Position - root.Position).Magnitude
                if dist < 200 and dist > 5 then
                    if Settings.Farming.SmartFarm then
                        local tween = TweenService:Create(root, TweenInfo.new(dist / Settings.Farming.FarmSpeed), {CFrame = obj.CFrame})
                        tween:Play()
                        tween.Completed:Wait()
                    else
                        root.CFrame = obj.CFrame
                    end
                    
                    if obj and obj.Parent then
                        firetouchinterest(root, obj, 0)
                        firetouchinterest(root, obj, 1)
                    end
                    task.wait(0.1)
                    break
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.05) do
        if not Settings.Farming.CoinMagnet then continue end
        
        local root = GetRootPart(GetCharacter(LocalPlayer))
        if not root then continue end
        
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():match("coin") then
                local dist = (obj.Position - root.Position).Magnitude
                if dist <= Settings.Farming.MagnetRange then
                    TweenService:Create(obj, TweenInfo.new(0.1), {CFrame = root.CFrame}):Play()
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if not Settings.Farming.AutoGrabGun then continue end
        
        local root = GetRootPart(GetCharacter(LocalPlayer))
        if not root then continue end
        
        for _, obj in pairs(Workspace:GetDescendants()) do
            local name = obj.Name:lower()
            if (name:match("gun") or name:match("pistol")) and obj:IsA("BasePart") then
                local dist = (obj.Position - root.Position).Magnitude
                if dist < 100 then
                    TweenService:Create(root, TweenInfo.new(0.3), {CFrame = obj.CFrame}):Play()
                    task.wait(0.3)
                    firetouchinterest(root, obj, 0)
                    firetouchinterest(root, obj, 1)
                end
            end
        end
    end
end)

