    Murder = { KillAura = false, KillAuraRange = 12, AutoKillVisible = false, AutoKillRange = 50 },
    Sheriff = { InstantKill = false, AutoShoot = false, ShootRange = 200 },
    Fling = { Enabled = false, Target = nil, Power = 500, AntiFling = false, SpecificTarget = nil },
    ESP = { Enabled = false, Boxes = true, Names = true, Distance = true, Roles = true, Tracers = false, MaxDistance = 1500 },
    Movement = { Speed = 16, Jump = 50, Fly = false, FlySpeed = 60, NoClip = false, InfiniteJump = false, AutoSprint = false },
    Farming = { AutoFarm = false, SmartFarm = true, CoinMagnet = false, MagnetRange = 60, AutoGrabGun = false, FarmSpeed = 250 },
    Misc = { FullBright = false, AntiAfk = true, NoFog = false }
}

--// CACHE
local ESPObjects = {}
local LastUpdate = 0
local Flinging = {}
local RoleColors = {
    Murderer = Color3.fromRGB(255, 50, 50),
    Sheriff = Color3.fromRGB(50, 100, 255),
    Innocent = Color3.fromRGB(150, 255, 150)
}

--// UTILITY
local function GetCharacter(player) 
    return player and player.Character 
end

local function GetRootPart(char) 
    return char and char:FindFirstChild("HumanoidRootPart") 
end

local function GetHumanoid(char) 
    return char and char:FindFirstChildOfClass("Humanoid") 
end

-- FIX #1: Ora ritorna anche il colore
local function GetPlayerRole(player)
    if not player then return "Innocent", RoleColors.Innocent end
    local backpack = player:FindFirstChild("Backpack")
    local char = GetCharacter(player)
    
    if (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
        return "Murderer", RoleColors.Murderer
    elseif (backpack and backpack:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun")) then
        return "Sheriff", RoleColors.Sheriff
    end
    return "Innocent", RoleColors.Innocent
end

local function GetMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        local role = GetPlayerRole(p)
        if role == "Murderer" then return p end
    end
    return nil
end

local function GetSheriff()
    for _, p in pairs(Players:GetPlayers()) do
        local role = GetPlayerRole(p)
        if role == "Sheriff" then return p end
    end
    return nil
end

--// UI LIBRARY
local UI = {}
function UI:CreateWindow(title)
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MM2HubV7"
    ScreenGui.Parent = CoreGui
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.ResetOnSpawn = false
    
    local DragonButton = Instance.new("TextButton")
    DragonButton.Size = UDim2.new(0, 70, 0, 70)
    DragonButton.Position = UDim2.new(1, -90, 0, 25)
    DragonButton.BackgroundColor3 = Color3.fromRGB(100, 180, 255)
    DragonButton.Text = "🐉"
    DragonButton.TextSize = 40
    DragonButton.Font = Enum.Font.GothamBold
    DragonButton.Parent = ScreenGui
    
    Instance.new("UICorner", DragonButton).CornerRadius = UDim.new(1, 0)
    
    local Main = Instance.new("Frame")
    Main.Size = UDim2.new(0, 750, 0, 500)
    Main.Position = UDim2.new(0.5, -375, 0.5, -250)
    Main.BackgroundColor3 = Color3.fromRGB(20, 25, 35)
    Main.BorderSizePixel = 0
    Main.Visible = false
    Main.Parent = ScreenGui
    
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 20)
    
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(100, 180, 255)
    Stroke.Thickness = 2
    Stroke.Parent = Main
    
    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 50)
    TopBar.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
    TopBar.BorderSizePixel = 0
    TopBar.Parent = Main
    
    Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 20)
    
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(0.7, 0, 1, 0)
    Title.Position = UDim2.new(0, 20, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = title
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 22
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = TopBar
    
    local Close = Instance.new("TextButton")
    Close.Size = UDim2.new(0, 35, 0, 35)
    Close.Position = UDim2.new(1, -45, 0, 7)
    Close.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    Close.Text = "×"
    Close.TextColor3 = Color3.fromRGB(255, 255, 255)
    Close.TextSize = 24
    Close.Font = Enum.Font.GothamBold
    Close.Parent = TopBar
    
    Instance.new("UICorner", Close).CornerRadius = UDim.new(0, 10)
    
    local TabFrame = Instance.new("Frame")
    TabFrame.Size = UDim2.new(0, 180, 1, -50)
    TabFrame.Position = UDim2.new(0, 0, 0, 50)
    TabFrame.BackgroundColor3 = Color3.fromRGB(25, 30, 40)
    TabFrame.BorderSizePixel = 0
    TabFrame.Parent = Main
    
    local ContentFrame = Instance.new("Frame")
    ContentFrame.Size = UDim2.new(1, -180, 1, -50)
    ContentFrame.Position = UDim2.new(0, 180, 0, 50)
    ContentFrame.BackgroundTransparency = 1
    ContentFrame.Parent = Main
    
    local Window = {
        ScreenGui = ScreenGui, 
        Main = Main, 
        DragonButton = DragonButton, 
        TabFrame = TabFrame, 
        ContentFrame = ContentFrame, 
        Tabs = {}, 
        CurrentTab = nil
    }
    
    local function ToggleGUI(show)
        if show then
            Main.Visible = true
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Back), {
                Size = UDim2.new(0, 750, 0, 500)
            }):Play()
            DragonButton.Visible = false
        else
            TweenService:Create(Main, TweenInfo.new(0.3), {
                Size = UDim2.new(0, 750, 0, 0)
            }):Play()
            task.delay(0.3, function() 
                Main.Visible = false 
                DragonButton.Visible = true 
            end)
        end
    end
    
    Close.MouseButton1Click:Connect(function() ToggleGUI(false) end)
    DragonButton.MouseButton1Click:Connect(function() ToggleGUI(true) end)
    
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Insert then 
            ToggleGUI(not Main.Visible) 
        end
    end)
    
    -- Dragging fix
    local dragging, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then 
            dragging = false 
        end
    end)
    
    return Window
end

function UI:CreateTab(window, name, icon, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 45)
    btn.Position = UDim2.new(0.05, 0, 0, #window.Tabs * 50 + 10)
    btn.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
    btn.Text = ""
    btn.Parent = window.TabFrame
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
    
    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.new(0, 35, 0, 35)
    iconLabel.Position = UDim2.new(0, 10, 0.5, -17)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = icon
    iconLabel.TextSize = 24
    iconLabel.Parent = btn
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -50, 1, 0)
    textLabel.Position = UDim2.new(0, 45, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = name
    textLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    textLabel.TextSize = 15
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Parent = btn
    
    local content = Instance.new("ScrollingFrame")
    content.Size = UDim2.new(1, 0, 1, 0)
    content.BackgroundTransparency = 1
    content.ScrollBarThickness = 4
    content.ScrollBarImageColor3 = color
    content.Visible = false
    content.Parent = window.ContentFrame
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 15)
    layout.Parent = content
    
    -- FIX #2: UIPadding corretto
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 20)
    padding.PaddingRight = UDim.new(0, 20)
    padding.PaddingTop = UDim.new(0, 20)
    padding.PaddingBottom = UDim.new(0, 20)
    padding.Parent = content
    
    local tab = {
        Button = btn, 
        Content = content, 
        TextLabel = textLabel, 
        Color = color
    }
    table.insert(window.Tabs, tab)
    
    btn.MouseButton1Click:Connect(function()
        if window.CurrentTab == tab then return end
        for _, t in pairs(window.Tabs) do
            t.Content.Visible = false
            t.Button.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
            t.TextLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        window.CurrentTab = tab
        content.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(50, 55, 70)
        textLabel.TextColor3 = color
    end)
    
    return content
end

function UI:CreateSection(parent, title, accentColor)
    local section = Instance.new("Frame")
