        Size = minimized and UDim2.new(1, -140, 0, 0) or UDim2.new(1, -140, 1, -40)
    }):Play()
    TweenService:Create(TabContainer, TweenInfo.new(0.3), {
        Size = minimized and UDim2.new(0, 140, 0, 0) or UDim2.new(0, 140, 1, -40)
    }):Play()
    MinBtn.Text = minimized and "+" or "−"
end)

