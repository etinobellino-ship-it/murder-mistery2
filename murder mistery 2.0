        MainFrame.Visible = not MainFrame.Visible
        print("GUI visibile:", MainFrame.Visible)
    end
end)

--// FEATURES IMPLEMENTATION

-- ESP
local ESPObjects = {}
local function CreateESP(player)
    if player == LocalPlayer then return end
    
    local esp = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        Tracer = Drawing.new("Line"),
        Role = Drawing.new("Text")
    }
    
    esp.Box.Visible = false
    esp.Box.Thickness = 1
    esp.Box.Filled = false
    
    esp.Name.Visible = false
    esp.Name.Size = 13
    esp.Name.Center = true
    esp.Name.Outline = true
    
    esp.Distance.Visible = false
    esp.Distance.Size = 11
    esp.Distance.Center = true
    esp.Distance.Outline = true
    
    esp.Tracer.Visible = false
    esp.Tracer.Thickness = 1
    
    esp.Role.Visible = false
    esp.Role.Size = 12
    esp.Role.Center = true
    esp.Role.Outline = true
    
    ESPObjects[player] = esp
end

-- Gun ESP
local GunESP = {}
local function UpdateGunESP()
    for _, obj in pairs(GunESP) do
        if obj then obj:Destroy() end
    end
    GunESP = {}
    
    if not Settings.ESP.GunESP then return end
    
    for _, item in pairs(Workspace:GetDescendants()) do
        if item.Name == "GunDrop" or item.Name == "DroppedGun" then
            local billboard = Instance.new("BillboardGui")
            billboard.Size = UDim2.new(0, 100, 0, 50)
            billboard.AlwaysOnTop = true
            billboard.StudsOffset = Vector3.new(0, 2, 0)
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = "🔫 GUN"
            label.TextColor3 = Color3.fromRGB(255, 215, 0)
            label.TextSize = 18
            label.Font = Enum.Font.GothamBold
            label.Parent = billboard
            
            local part = item:IsA("Model") and item:FindFirstChildWhichIsA("BasePart") or item
            if part then
                billboard.Adornee = part
                billboard.Parent = part
                table.insert(GunESP, billboard)
            end
        end
    end
end

-- Main ESP Loop
RunService.RenderStepped:Connect(function()
    for player, esp in pairs(ESPObjects) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Head") then
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            local distance = (RootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
            
            if onScreen and distance <= Settings.ESP.MaxDistance and Settings.ESP.Enabled then
                local role = "Innocent"
                local color = Color3.fromRGB(0, 255, 0)
                
                if player.Backpack:FindFirstChild("Knife") or player.Character:FindFirstChild("Knife") then
                    role = "Murderer"
                    color = Color3.fromRGB(255, 0, 0)
                elseif player.Backpack:FindFirstChild("Gun") or player.Character:FindFirstChild("Gun") then
                    role = "Sheriff"
                    color = Color3.fromRGB(0, 100, 255)
                end
                
                local scale = 1000 / pos.Z
                local size = math.clamp(scale, 10, 50)
                
                if Settings.ESP.Boxes then
                    esp.Box.Size = Vector2.new(size * 0.6, size * 1.2)
                    esp.Box.Position = Vector2.new(pos.X - size * 0.3, pos.Y - size * 0.6)
                    esp.Box.Color = color
                    esp.Box.Visible = true
                else
                    esp.Box.Visible = false
                end
                
                if Settings.ESP.Names then
                    esp.Name.Position = Vector2.new(pos.X, pos.Y - size * 0.7)
                    esp.Name.Text = player.Name
                    esp.Name.Color = color
                    esp.Name.Visible = true
                else
                    esp.Name.Visible = false
                end
                
                if Settings.ESP.Distance then
                    esp.Distance.Position = Vector2.new(pos.X, pos.Y + size * 0.7)
                    esp.Distance.Text = math.floor(distance) .. "m"
                    esp.Distance.Color = Color3.fromRGB(255, 255, 255)
                    esp.Distance.Visible = true
                else
                    esp.Distance.Visible = false
                end
                
                if Settings.ESP.Tracers then
                    esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    esp.Tracer.To = Vector2.new(pos.X, pos.Y)
                    esp.Tracer.Color = color
                    esp.Tracer.Visible = true
                else
                    esp.Tracer.Visible = false
                end
                
                if Settings.ESP.Roles then
                    esp.Role.Position = Vector2.new(pos.X, pos.Y - size * 0.9)
                    esp.Role.Text = role
                    esp.Role.Color = color
                    esp.Role.Visible = true
                else
                    esp.Role.Visible = false
                end
            else
                for _, obj in pairs(esp) do obj.Visible = false end
            end
        else
            for _, obj in pairs(esp) do obj.Visible = false end
        end
    end
end)

-- Aimbot
local function GetClosestPlayer()
    local closest = nil
    local minDist = Settings.Combat.FOV
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(Settings.Combat.AimPart) then
            if Settings.Combat.TeamCheck and player.Team == LocalPlayer.Team then continue end
            
            local pos = Camera:WorldToViewportPoint(player.Character[Settings.Combat.AimPart].Position)
            local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
            
            if dist < minDist then
                minDist = dist
                closest = player
            end
        end
    end
    
    return closest
end

-- Fly
local flyConnection
RunService.RenderStepped:Connect(function()
    if Settings.Movement.Fly and RootPart then
        if not RootPart:FindFirstChild("FlyGyro") then
            local bodyGyro = Instance.new("BodyGyro")
            local bodyVel = Instance.new("BodyVelocity")
            bodyGyro.Name = "FlyGyro"
            bodyVel.Name = "FlyVel"
            bodyGyro.Parent = RootPart
            bodyVel.Parent = RootPart
            bodyGyro.MaxTorque = Vector3.new(500000, 500000, 500000)
            bodyGyro.P = 10000
            bodyVel.MaxForce = Vector3.new(500000, 500000, 500000)
        end
        
        local bodyGyro = RootPart:FindFirstChild("FlyGyro")
        local bodyVel = RootPart:FindFirstChild("FlyVel")
        
        if bodyGyro and bodyVel then
            local dir = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
            
            bodyGyro.CFrame = Camera.CFrame
            bodyVel.Velocity = dir * Settings.Movement.FlySpeed
        end
    else
        if RootPart then
            if RootPart:FindFirstChild("FlyGyro") then RootPart.FlyGyro:Destroy() end
            if RootPart:FindFirstChild("FlyVel") then RootPart.FlyVel:Destroy() end
        end
    end
end)

-- No Clip
RunService.Stepped:Connect(function()
    if Settings.Movement.NoClip and Character then
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Auto Farm
spawn(function()
    while wait(0.1) do
        if Settings.Farming.AutoFarm then
            for _, coin in pairs(Workspace:GetDescendants()) do
                if coin.Name == "Coin" and coin:IsA("BasePart") then
                    if RootPart then
                        RootPart.CFrame = coin.CFrame
                        wait(0.2)
                    end
                end
            end
        end
        
        if Settings.Farming.CoinMagnet then
            for _, coin in pairs(Workspace:GetDescendants()) do
                if coin.Name == "Coin" and coin:IsA("BasePart") then
                    local dist = (coin.Position - RootPart.Position).Magnitude
                    if dist <= Settings.Farming.MagnetRange then
                        coin.CFrame = RootPart.CFrame
                    end
                end
            end
        end
        
        if Settings.Farming.AutoGrabGun then
            for _, item in pairs(Workspace:GetDescendants()) do
                if item.Name == "GunDrop" or item.Name == "DroppedGun" then
                    local part = item:IsA("Model") and item:FindFirstChildWhichIsA("BasePart") or item
                    if part and RootPart then
                        RootPart.CFrame = CFrame.new(part.Position)
                        wait(0.5)
                    end
                end
            end
        end
    end
end)

-- Combat Features
spawn(function()
    while wait(0.1) do
        local knife = LocalPlayer.Backpack:FindFirstChild("Knife") or Character:FindFirstChild("Knife")
        
        if knife and Settings.Combat.KillAura then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (player.Character.HumanoidRootPart.Position - RootPart.Position).Magnitude
                    if dist <= 10 then
                        local args = {[1] = "Throw", [2] = player.Character.HumanoidRootPart.Position}
                        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ThrowKnife"):FireServer(unpack(args))
                    end
                end
            end
        end
        
        if knife and Settings.Combat.AutoStab then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (player.Character.HumanoidRootPart.Position - RootPart.Position).Magnitude
                    if dist <= 6 then
                        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Stab"):FireServer()
                    end
                end
            end
        end
        
        local gun = LocalPlayer.Backpack:FindFirstChild("Gun") or Character:FindFirstChild("Gun")
        if gun and Settings.Combat.AutoShoot then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local hasKnife = player.Backpack:FindFirstChild("Knife") or player.Character:FindFirstChild("Knife")
                    if hasKnife and player.Character:FindFirstChild("Head") then
                        local args = {[1] = player.Character.Head.Position, [2] = player.Character.Head}
                        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ShootGun"):FireServer(unpack(args))
                    end
                end
            end
        end
    end
end)

-- Aimbot Loop
RunService.RenderStepped:Connect(function()
    if Settings.Combat.Aimbot then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild(Settings.Combat.AimPart) then
            local pos = target.Character[Settings.Combat.AimPart].Position
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), Settings.Combat.Smoothness)
        end
    end
end)

