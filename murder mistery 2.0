    KillAura = false,
    EspEnabled = false,
    WalkSpeed = 16,
    JumpPower = 50,
    FlyEnabled = false,
    FlySpeed = 50,
    AuraRange = 20,
    SelectedSkin = "Default"
}

-- // COLORS (Low-Lag Dark Theme)
local Theme = {
    Main = Color3.fromRGB(10, 10, 15),
    Side = Color3.fromRGB(20, 20, 25),
    Accent = Color3.fromRGB(0, 170, 255),
    Text = Color3.fromRGB(255, 255, 255),
    Button = Color3.fromRGB(30, 30, 40),
    Close = Color3.fromRGB(255, 40, 40)
}

-- // GUI INITIALIZATION
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local SideBar = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local ContentFrame = Instance.new("Frame")
local TabContainer = Instance.new("Frame")
local CloseBtn = Instance.new("TextButton")
local DragonImg = Instance.new("ImageLabel")

pcall(function() ScreenGui.Parent = game:GetService("CoreGui") end)
if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
ScreenGui.Name = "NegroFiduciaHub"

-- Main Frame Design
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Theme.Main
MainFrame.Position = UDim2.new(0.3, 0, 0.25, 0)
MainFrame.Size = UDim2.new(0, 550, 0, 380)
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)
local MainStroke = Instance.new("UIStroke", MainFrame)
MainStroke.Thickness = 2; MainStroke.Color = Theme.Accent

-- SideBar Design
SideBar.Parent = MainFrame
SideBar.BackgroundColor3 = Theme.Side
SideBar.Size = UDim2.new(0, 140, 1, 0)
Instance.new("UICorner", SideBar).CornerRadius = UDim.new(0, 12)

DragonImg.Parent = SideBar
DragonImg.BackgroundTransparency = 1
DragonImg.Position = UDim2.new(0.1, 0, 0.05, 0)
DragonImg.Size = UDim2.new(0.8, 0, 0, 60)
DragonImg.Image = "rbxassetid://14532935813"

Title.Parent = SideBar
Title.Text = "NEGRO DI\nFIDUCIA HUB"
Title.TextColor3 = Theme.Accent
Title.TextSize = 16; Title.Font = Enum.Font.GothamBold
Title.Position = UDim2.new(0, 0, 0, 70); Title.Size = UDim2.new(1, 0, 0, 50)
Title.BackgroundTransparency = 1

-- Close Button (X Rossa)
CloseBtn.Parent = MainFrame
CloseBtn.Text = "X"; CloseBtn.TextColor3 = Color3.new(1,1,1)
CloseBtn.BackgroundColor3 = Theme.Close; CloseBtn.Size = UDim2.new(0, 30, 0, 30)
CloseBtn.Position = UDim2.new(1, -35, 0, 5); CloseBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 8)

-- Content Area
ContentFrame.Parent = MainFrame
ContentFrame.Position = UDim2.new(0, 150, 0, 15)
ContentFrame.Size = UDim2.new(1, -160, 1, -30)
ContentFrame.BackgroundTransparency = 1

TabContainer.Parent = ContentFrame
TabContainer.Size = UDim2.new(1, 0, 1, 0)
TabContainer.BackgroundTransparency = 1

-- // UTILITY FUNCTIONS
local function CreateSection(name)
    local section = Instance.new("ScrollingFrame")
    section.Name = name
    section.Size = UDim2.new(1, 0, 1, 0)
    section.BackgroundTransparency = 1
    section.CanvasSize = UDim2.new(0, 0, 2, 0)
    section.ScrollBarThickness = 2
    section.Visible = false
    section.Parent = TabContainer
    
    local layout = Instance.new("UIListLayout", section)
    layout.Padding = UDim.new(0, 8)
    return section
end

local function CreateButton(text, parent, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.BackgroundColor3 = Theme.Button
    btn.Text = text; btn.TextColor3 = Theme.Text
    btn.Font = Enum.Font.GothamMedium; btn.TextSize = 13; btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local function CreateToggle(text, default, parent, callback)
    local state = default
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.BackgroundColor3 = state and Theme.Accent or Theme.Button
    btn.Text = text .. " : " .. (state and "ON" or "OFF")
    btn.TextColor3 = Theme.Text; btn.Font = Enum.Font.GothamMedium; btn.TextSize = 13; btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. " : " .. (state and "ON" or "OFF")
        btn.BackgroundColor3 = state and Theme.Accent or Theme.Button
        callback(state)
    end)
    return btn
end

-- // TABS SETUP
local MainTab = CreateSection("Main")
local CombatTab = CreateSection("Combat")
local VisualTab = CreateSection("Visuals")
local SpawnerTab = CreateSection("Spawner")

MainTab.Visible = true

-- Tab Navigation Buttons (on SideBar)
local tabs = {
    {"Main", MainTab}, {"Combat", CombatTab}, {"Visuals", VisualTab}, {"Spawner", SpawnerTab}
}

for i, tabData in ipairs(tabs) do
    local tBtn = Instance.new("TextButton")
    tBtn.Size = UDim2.new(0, 120, 0, 35)
    tBtn.Position = UDim2.new(0, 10, 0, 130 + (i*40))
    tBtn.BackgroundColor3 = Theme.Button
    tBtn.Text = tabData[1]; tBtn.TextColor3 = Theme.Text; tBtn.Font = Enum.Font.GothamMedium
    tBtn.Parent = SideBar
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 6)
    tBtn.MouseButton1Click:Connect(function()
        for _, v in pairs(TabContainer:GetChildren()) do v.Visible = false end
        tabData[2].Visible = true
    end)
end

-- // FEATURES IMPLEMENTATION

-- [ MAIN TAB ]
CreateToggle("Fly (No Clip)", false, MainTab, function(v) Settings.FlyEnabled = v end)
CreateButton("Speed Boost (High)", MainTab, function() Settings.WalkSpeed = 60 end)
CreateButton("Reset Speed", MainTab, function() Settings.WalkSpeed = 16 end)
CreateButton("High Jump", MainTab, function() Settings.JumpPower = 100 end)

-- [ COMBAT TAB ]
CreateToggle("Kill Aura", false, CombatTab, function(v) Settings.KillAura = v end)
CreateButton("Max Aura Range", CombatTab, function() Settings.AuraRange = 50 end)

-- [ VISUALS TAB ]
CreateToggle("Player ESP", false, VisualTab, function(v) Settings.EspEnabled = v end)

-- [ SPAWNER TAB ]
local Skins = {"Default", "Slasher", "Crimson", "Ice", "Void", "Golden", "Rainbow", "Dragon"}
for _, skin in ipairs(Skins) do
    CreateButton("Spawn " .. skin .. " Skin", SpawnerTab, function()
        local weaponModel = nil
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("Tool") and (v.Name == skin or v.Name:find(skin)) then
                weaponModel = v; break
            end
        end
        if weaponModel then weaponModel:Clone().Parent = LocalPlayer.Backpack end
    end)
end

-- // CORE ENGINE (Low-Lag Optimization)
RunService.Heartbeat:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = Settings.WalkSpeed
        LocalPlayer.Character.Humanoid.JumpPower = Settings.JumpPower
        
        if Settings.FlyEnabled then
            LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0,0,0) -- Simple hover fly
        end
    end

    if Settings.KillAura then
        local char = LocalPlayer.Character
        if char and (char:FindFirstChild("Knife") or LocalPlayer:GetAttribute("Role") == "Murderer") then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if (char.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude <= Settings.AuraRange then
                        -- Target Remote logic would go here (standard MM2 remote firing)
                    end
                end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if Settings.EspEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hl = p.Character:FindFirstChild("XenoESP") or Instance.new("Highlight", p.Character)
                hl.Name = "XenoESP"; hl.FillColor = Color3.fromRGB(0, 170, 255)
            end
        end
    end
end)

-- // GUI LOGIC (Close & Drag)
CloseBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

local dragging, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true; dragStart = input.Position; startPos = MainFrame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

print("Negro di Fiducia Hub Loaded Successfully!")
