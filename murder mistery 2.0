UI:CreateToggle(cSec, "Aimbot", false, function(v) Settings.Combat.Aimbot = v end, CombatColor)
UI:CreateToggle(cSec, "Kill Aura", false, function(v) Settings.Combat.KillAura = v end, CombatColor)
UI:CreateToggle(cSec, "Auto Stab", false, function(v) Settings.Combat.AutoStab = v end, CombatColor)
UI:CreateToggle(cSec, "Auto Shoot", false, function(v) Settings.Combat.AutoShoot = v end, CombatColor)
UI:CreateSlider(cSec, "FOV", 10, 500, 150, function(v) Settings.Combat.FOV = v end, CombatColor)
UI:CreateSlider(cSec, "Smoothness", 1, 100, 8, function(v) Settings.Combat.Smoothness = v/100 end, CombatColor)

--// ESP
local eSec = UI:CreateSection(ESP_Tab, "ESP Settings", ESPColor)
UI:CreateToggle(eSec, "Enable ESP", false, function(v) Settings.ESP.Enabled = v end, ESPColor)
UI:CreateToggle(eSec, "Boxes", true, function(v) Settings.ESP.Boxes = v end, ESPColor)
UI:CreateToggle(eSec, "Names", true, function(v) Settings.ESP.Names = v end, ESPColor)
UI:CreateToggle(eSec, "Distance", true, function(v) Settings.ESP.Distance = v end, ESPColor)
UI:CreateToggle(eSec, "Roles", true, function(v) Settings.ESP.Roles = v end, ESPColor)
UI:CreateToggle(eSec, "Tracers", false, function(v) Settings.ESP.Tracers = v end, ESPColor)
UI:CreateSlider(eSec, "Max Distance", 100, 3000, 1500, function(v) Settings.ESP.MaxDistance = v end, ESPColor)

--// MOVEMENT
local mSec = UI:CreateSection(MoveTab, "Movement", MoveColor)
UI:CreateToggle(mSec, "Fly", false, function(v) Settings.Movement.Fly = v end, MoveColor)
UI:CreateToggle(mSec, "No Clip", false, function(v) Settings.Movement.NoClip = v end, MoveColor)
UI:CreateToggle(mSec, "Infinite Jump", false, function(v) Settings.Movement.InfiniteJump = v end, MoveColor)
UI:CreateToggle(mSec, "Auto Sprint", false, function(v) Settings.Movement.AutoSprint = v end, MoveColor)
UI:CreateSlider(mSec, "Speed", 16, 200, 16, function(v) 
    Settings.Movement.Speed = v
    local hum = GetHumanoid(GetCharacter(LocalPlayer))
    if hum then hum.WalkSpeed = v end
end, MoveColor)
UI:CreateSlider(mSec, "Jump", 50, 200, 50, function(v) 
    Settings.Movement.Jump = v
    local hum = GetHumanoid(GetCharacter(LocalPlayer))
    if hum then hum.JumpPower = v end
end, MoveColor)
UI:CreateSlider(mSec, "Fly Speed", 10, 200, 60, function(v) Settings.Movement.FlySpeed = v end, MoveColor)

--// FARMING
local fSec = UI:CreateSection(FarmTab, "Auto Farm", FarmColor)
UI:CreateToggle(fSec, "Auto Farm", false, function(v) Settings.Farming.AutoFarm = v end, FarmColor)
UI:CreateToggle(fSec, "Smart Farm", true, function(v) Settings.Farming.SmartFarm = v end, FarmColor)
UI:CreateToggle(fSec, "Coin Magnet", false, function(v) Settings.Farming.CoinMagnet = v end, FarmColor)
UI:CreateToggle(fSec, "Auto Grab Gun", false, function(v) Settings.Farming.AutoGrabGun = v end, FarmColor)
UI:CreateSlider(fSec, "Magnet Range", 10, 150, 60, function(v) Settings.Farming.MagnetRange = v end, FarmColor)
UI:CreateSlider(fSec, "Farm Speed", 50, 500, 250, function(v) Settings.Farming.FarmSpeed = v end, FarmColor)

--// MISC
local miscSec = UI:CreateSection(MiscTab, "Settings", MiscColor)
UI:CreateToggle(miscSec, "Full Bright", false, function(v) 
    Settings.Misc.FullBright = v
    Lighting.Brightness = v and 10 or 1
    Lighting.GlobalShadows = not v
end, MiscColor)
UI:CreateToggle(miscSec, "Anti AFK", true, function(v) Settings.Misc.AntiAfk = v end, MiscColor)
UI:CreateToggle(miscSec, "No Fog", false, function(v) 
    Settings.Misc.NoFog = v
    if v then
        Lighting.FogEnd = 100000
    else
        Lighting.FogEnd = 500
    end
end, MiscColor)

UI:CreateButton(miscSec, "Server Hop", function()
    local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    for _, server in pairs(servers.data) do
        if server.playing < server.maxPlayers and server.id ~= game.JobId then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id)
            break
        end
    end
end, MiscColor)

UI:CreateButton(miscSec, "Rejoin", function()
    TeleportService:Teleport(game.PlaceId)
end, MiscColor)

--// ESP SYSTEM (Working)
local function CreateESP(player)
    if player == LocalPlayer then return end
    ESPObjects[player] = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        Role = Drawing.new("Text"),
        Tracer = Drawing.new("Line")
    }
    for _, obj in pairs(ESPObjects[player]) do
        obj.Visible = false
        obj.Center = true
    end
    ESPObjects[player].Box.Thickness = 1
    ESPObjects[player].Box.Filled = false
    ESPObjects[player].Tracer.Thickness = 1
end

RunService.RenderStepped:Connect(function()
    if tick() - LastUpdate < 0.03 then return end
    LastUpdate = tick()
    
    for player, esp in pairs(ESPObjects) do
        local success = pcall(function()
            if not Settings.ESP.Enabled then
                for _, obj in pairs(esp) do obj.Visible = false end
                return
            end
            
            local char = GetCharacter(player)
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") then
                local pos, onScreen = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
                local myChar = GetCharacter(LocalPlayer)
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                
                if myRoot and onScreen then
                    local dist = (myRoot.Position - char.HumanoidRootPart.Position).Magnitude
                    if dist <= Settings.ESP.MaxDistance then
                        local role, color = GetPlayerRole(player)
                        local scale = math.clamp(1000 / pos.Z, 10, 50)
                        
                        if Settings.ESP.Boxes then
                            esp.Box.Size = Vector2.new(scale * 0.6, scale * 1.2)
                            esp.Box.Position = Vector2.new(pos.X - scale * 0.3, pos.Y - scale * 0.6)
                            esp.Box.Color = color
                            esp.Box.Visible = true
                        else
                            esp.Box.Visible = false
                        end
                        
                        if Settings.ESP.Names then
                            esp.Name.Position = Vector2.new(pos.X, pos.Y - scale * 0.8)
                            esp.Name.Text = player.Name
                            esp.Name.Color = color
                            esp.Name.Size = 13
                            esp.Name.Visible = true
                        else
                            esp.Name.Visible = false
                        end
                        
                        if Settings.ESP.Distance then
                            esp.Distance.Position = Vector2.new(pos.X, pos.Y + scale * 0.7)
                            esp.Distance.Text = math.floor(dist) .. "m"
                            esp.Distance.Color = Color3.fromRGB(255, 255, 255)
                            esp.Distance.Size = 11
                            esp.Distance.Visible = true
                        else
                            esp.Distance.Visible = false
                        end
                        
                        if Settings.ESP.Roles then
                            esp.Role.Position = Vector2.new(pos.X, pos.Y - scale * 1.1)
                            esp.Role.Text = role
                            esp.Role.Color = color
                            esp.Role.Size = 12
                            esp.Role.Visible = true
                        else
                            esp.Role.Visible = false
                        end
                        
                        if Settings.ESP.Tracers then
                            esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            esp.Tracer.To = Vector2.new(pos.X, pos.Y)
                            esp.Tracer.Color = color
                            esp.Tracer.Visible = true
                        else
                            esp.Tracer.Visible = false
                        end
                    else
                        for _, obj in pairs(esp) do obj.Visible = false end
                    end
                else
                    for _, obj in pairs(esp) do obj.Visible = false end
                end
            else
                for _, obj in pairs(esp) do obj.Visible = false end
            end
        end)
        if not success then
            for _, obj in pairs(esp) do obj.Visible = false end
        end
    end
end)

--// AIMBOT (Working)
local function GetClosest()
    local closest, minDist = nil, Settings.Combat.FOV
    local myChar = GetCharacter(LocalPlayer)
    if not myChar then return nil end
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = GetCharacter(p)
            if char then
                local targetPart = char:FindFirstChild(Settings.Combat.AimPart) or char:FindFirstChild("Head")
                if targetPart then
                    local pos = Camera:WorldToViewportPoint(targetPart.Position)
                    local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                    if dist < minDist then
                        if Settings.Combat.TeamCheck then
                            local role = GetPlayerRole(p)
                            if role == "Murderer" or role == "Sheriff" then
                                minDist, closest = dist, p
                            end
                        else
                            minDist, closest = dist, p
                        end
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if Settings.Combat.Aimbot then
        local target = GetClosest()
        if target then
            local char = GetCharacter(target)
            if char then
                local targetPart = char:FindFirstChild(Settings.Combat.AimPart) or char:FindFirstChild("Head")
                if targetPart then
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPart.Position), Settings.Combat.Smoothness)
                end
            end
        end
    end
end)

--// COMBAT FEATURES (Working)
task.spawn(function()
    while task.wait(0.1) do
        local char = GetCharacter(LocalPlayer)
        if not char then continue end
        
        local knife = LocalPlayer.Backpack:FindFirstChild("Knife") or char:FindFirstChild("Knife")
        local gun = LocalPlayer.Backpack:FindFirstChild("Gun") or char:FindFirstChild("Gun")
        
        if knife and Settings.Combat.KillAura then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local targetChar = GetCharacter(p)
                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                        local dist = (targetChar.HumanoidRootPart.Position - char:GetPivot().Position).Magnitude
                        if dist <= 12 then
                            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                            if remotes then
                                local throw = remotes:FindFirstChild("ThrowKnife")
                                if throw then
                                    throw:FireServer("Throw", targetChar.HumanoidRootPart.Position)
                                end
                            end
                        end
                    end
                end
            end
        end
        
        if knife and Settings.Combat.AutoStab then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local targetChar = GetCharacter(p)
                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                        local dist = (targetChar.HumanoidRootPart.Position - char:GetPivot().Position).Magnitude
                        if dist <= 6 then
                            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                            if remotes then
                                local stab = remotes:FindFirstChild("Stab")
                                if stab then
                                    stab:FireServer()
                                end
                            end
                        end
                    end
                end
            end
        end
        
        if gun and Settings.Combat.AutoShoot then
            for _, p in pairs(Players:GetPlayers()) do
                local role = GetPlayerRole(p)
                if role == "Murderer" then
                    local targetChar = GetCharacter(p)
                    if targetChar and targetChar:FindFirstChild("Head") then
                        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                        if remotes then
                            local shoot = remotes:FindFirstChild("ShootGun")
                            if shoot then
                                shoot:FireServer(targetChar.Head.Position, targetChar.Head)
                            end
                        end
                    end
                end
            end
        end
    end
end)

--// FLY SYSTEM (Working)
RunService.RenderStepped:Connect(function()
    local char = GetCharacter(LocalPlayer)
    if not char then return end
    local root = GetRootPart(char)
    if not root then return end
    
    if Settings.Movement.Fly then
        if not root:FindFirstChild("FlyGyro") then
            local gyro = Instance.new("BodyGyro")
            gyro.Name = "FlyGyro"
            gyro.MaxTorque = Vector3.new(500000, 500000, 500000)
            gyro.Parent = root
            
            local vel = Instance.new("BodyVelocity")
            vel.Name = "FlyVel"
            vel.MaxForce = Vector3.new(500000, 500000, 500000)
            vel.Parent = root
        end
        
        local gyro = root.FlyGyro
        local vel = root.FlyVel
        local dir = Vector3.new(0, 0, 0)
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
        
        gyro.CFrame = Camera.CFrame
        vel.Velocity = dir * Settings.Movement.FlySpeed
    else
        if root:FindFirstChild("FlyGyro") then root.FlyGyro:Destroy() end
        if root:FindFirstChild("FlyVel") then root.FlyVel:Destroy() end
    end
end)

