-- // UI HELPERS (MIGLIORATI)
local function CreateSection(name)
    local section = Instance.new("ScrollingFrame")
    section.Name = name
    section.Size = UDim2.new(1, 0, 1, 0)
    section.BackgroundTransparency = 1
    section.CanvasSize = UDim2.new(0, 0, 2, 0)
    section.ScrollBarThickness = 2
    section.ScrollBarInset = Enum.ScrollBarInset.ScrollBar
    section.Visible = false
    section.Parent = TabContainer
    Instance.new("UIListLayout", section).Padding = UDim.new(0, 8)
    return section
end

local function CreateToggle(text, default, parent, callback)
    local state = default
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.BackgroundColor3 = state and Theme.Accent or Theme.Button
    btn.Text = text .. " : " .. (state and "ON" or "OFF")
    btn.TextColor3 = Theme.Text
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.Parent = parent
    btn.TextScaled = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. " : " .. (state and "ON" or "OFF")
        btn.BackgroundColor3 = state and Theme.Accent or Theme.Button
        callback(state)
    end)
end

local function CreateSlider(text, min, max, default, parent, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 45)
    frame.BackgroundColor3 = Theme.Button
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Text = text .. ": " .. default
    lbl.Size = UDim2.new(1, 0, 0, 20)
    lbl.TextColor3 = Theme.Text
    lbl.BackgroundTransparency = 1
    lbl.Parent = frame

    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(1, -20, 0, 10)
    slider.Position = UDim2.new(0, 10, 0, 25)
    slider.BackgroundColor3 = Theme.Accent
    slider.Parent = frame
    Instance.new("UICorner", slider).CornerRadius = UDim.new(0, 5)

    local sliderBtn = Instance.new("TextButton")
    sliderBtn.Size = UDim2.new(0, 10, 1, 0)
    sliderBtn.Position = UDim2.new(0, 0, 0, 0)
    sliderBtn.BackgroundColor3 = Theme.Accent
    sliderBtn.Text = ""
    sliderBtn.Parent = slider
    Instance.new("UICorner", sliderBtn).CornerRadius = UDim.new(0, 5)

    sliderBtn.MouseButton1Click:Connect(function()
        local newVal = default + 5
        if newVal > max then newVal = min end
        default = newVal
        lbl.Text = text .. ": " .. default
        slider.Size = UDim2.new((default - min) / (max - min), -20, 0, 10)
        callback(default)
    end)
    sliderBtn.MouseButton1Down:Connect(function()
        local drag = true
        local startPos = sliderBtn.Position
        local startX = UIS:GetMouseLocation().X
        UIS.InputChanged:Connect(function(input)
            if drag and input.UserInputType == Enum.UserInputType.MouseMovement then
                local deltaX = input.Position.X - startX
                local newX = startPos.X.Scale + (deltaX / slider.Parent.Size.X.Scale)
                newX = math.clamp(newX, 0, 1)
                sliderBtn.Position = UDim2.new(newX, 0, 0, 0)
                local newVal = min + (newX * (max - min))
                default = math.round(newVal)
                lbl.Text = text .. ": " .. default
                callback(default)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                drag = false
            end
        end)
    end)
    sliderBtn.MouseEnter:Connect(function()
        sliderBtn.Size = UDim2.new(0, 10, 1, 0)
    end)
    sliderBtn.MouseLeave:Connect(function()
        sliderBtn.Size = UDim2.new(0, 10, 1, 0)
    end)
end

-- // TABS SETUP
local MainTab = CreateSection("Main")
local CombatTab = CreateSection("Combat")
local VisualTab = CreateSection("Visuals")
MainTab.Visible = true

local tabs = {{"Main", MainTab}, {"Combat", CombatTab}, {"Visuals", VisualTab}}
for i, tabData in ipairs(tabs) do
    local tBtn = Instance.new("TextButton")
    tBtn.Size = UDim2.new(0, 120, 0, 35)
    tBtn.Position = UDim2.new(0, 10, 0, 130 + (i-1)*40)
    tBtn.BackgroundColor3 = Theme.Button
    tBtn.Text = tabData[1]
    tBtn.TextColor3 = Theme.Text
    tBtn.Parent = SideBar
    tBtn.TextScaled = true
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 6)
    tBtn.MouseButton1Click:Connect(function()
        for _, v in pairs(TabContainer:GetChildren()) do v.Visible = false end
        tabData[2].Visible = true
    end)
end

-- // FEATURES IMPLEMENTATION
CreateToggle("Fly", false, MainTab, function(v) Settings.FlyEnabled = v end)
CreateToggle("Speed Boost", false, MainTab, function(v) Settings.WalkSpeed = v and 60 or 16 end)
CreateToggle("Role ESP", false, VisualTab, function(v) Settings.EspEnabled = v end)

local SheriffLabel = Instance.new("TextLabel", CombatTab)
